# MinIO root credentials for local infrastructure
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-this-minio-password

# Local MinIO endpoints used by future integrations
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_CONSOLE=9001
MINIO_REGION=us-east-1

# S3-compatible credentials and region for clients
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=change-this-minio-password
AWS_DEFAULT_REGION=us-east-1
AWS_S3_ADDRESSING_STYLE=path

# Optional backend override: auto (default), minio, or s3
# - auto: use MinIO when endpoint is set; otherwise use native AWS S3
# - minio: force MinIO/S3-compatible endpoint mode
# - s3: force native AWS S3 mode (no custom endpoint)
OBSERVED_STORAGE_BACKEND=auto

# Local/dev MinIO mode: keep endpoint set
OBSERVED_STORAGE_S3_ENDPOINT_URL=http://localhost:9000
MLFLOW_S3_ENDPOINT_URL=http://minio:9000
DVC_S3_ENDPOINT_URL=http://localhost:9000

# Optional bucket alias override (useful for AWS where bucket is not literally named "models")
OBSERVED_STORAGE_BUCKET_MODELS=models

# AWS/prod native S3 mode:
# - unset custom endpoint vars (OBSERVED_STORAGE_S3_ENDPOINT_URL / DVC_S3_ENDPOINT_URL / MLFLOW_S3_ENDPOINT_URL)
# - provide AWS auth via env credentials or IAM role

# Reserved bucket naming convention for future integration
# mlflow-artifacts
# models
# datasets
# reports
# batch-predictions

# Optional API/inference fallback for downloading model bundles from object storage
OBSERVED_ENABLE_OBJECT_STORAGE_MODEL_FALLBACK=false
OBSERVED_ENABLE_LEGACY_MODEL_PATH_FALLBACK=true
OBSERVED_STAGE1_MODEL_VERSION=
OBSERVED_STAGE2_MODEL_VERSION=
